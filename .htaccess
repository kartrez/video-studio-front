Options -MultiViews -Indexes +FollowSymLinks
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

RewriteRule ^_nuxt/ - [L]
RewriteRule ^404\.html$ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Прямой адрес проекта и просмотра: оболочки нет в сборке, Vue Router читает настоящий путь.
RewriteCond %{DOCUMENT_ROOT}/studio/index.html -f
RewriteRule ^studio/project/ /studio/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/studio/index.html -f
RewriteRule ^studio/watch/ /studio/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/studio/share/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/studio/index.html -f
RewriteRule ^studio/share/?$ /studio/index.html [L]

ErrorDocument 404 /404.html
